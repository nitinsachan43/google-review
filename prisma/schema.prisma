generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum GlobalRole { USER SUPPORT PLATFORM_ADMIN SUPER_ADMIN }
enum TenantRole { OWNER ADMIN MANAGER STAFF VIEWER AGENCY_OWNER AGENCY_ADMIN AGENCY_STAFF }
enum Status { ACTIVE INACTIVE DISABLED PENDING }
enum SubscriptionStatus { TRIALING ACTIVE PAUSED CANCELLED EXPIRED PAST_DUE }
enum PaymentStatus { CREATED AUTHORIZED CAPTURED FAILED REFUNDED }

model User { id String @id @default(cuid()) email String @unique name String passwordHash String globalRole GlobalRole @default(USER) active Boolean @default(true) sessions Session[] memberships TenantUser[] invitations TeamInvitation[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? @@index([email]) }
model Session { id String @id @default(cuid()) tokenHash String @unique userId String user User @relation(fields:[userId], references:[id], onDelete:Cascade) expiresAt DateTime createdAt DateTime @default(now()) @@index([userId]) }
model Tenant { id String @id @default(cuid()) name String slug String @unique status Status @default(ACTIVE) trialStartedAt DateTime? trialEndsAt DateTime? users TenantUser[] businesses Business[] subscriptions Subscription[] settings TenantSetting? brand BrandSetting? auditLogs AuditLog[] apiKeys ApiKey[] webhookEndpoints WebhookEndpoint[] aiUsage AiUsage[] payments Payment[] agencyClient AgencyClient? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? @@index([createdAt]) }
model TenantUser { id String @id @default(cuid()) tenantId String userId String role TenantRole tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) user User @relation(fields:[userId],references:[id],onDelete:Cascade) createdAt DateTime @default(now()) @@unique([tenantId,userId]) @@index([tenantId]) }
model Business { id String @id @default(cuid()) tenantId String tenant Tenant @relation(fields:[tenantId],references:[id]) name String industry String? website String? phone String? email String? description String? address String? country String? state String? city String? postalCode String? timezone String @default("UTC") currency String @default("INR") brandColor String @default("#2563eb") locations Location[] campaigns QrCampaign[] feedbackTags FeedbackTag[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? @@index([tenantId]) }
model Location { id String @id @default(cuid()) tenantId String businessId String business Business @relation(fields:[businessId],references:[id]) name String googlePlaceId String? googleBusinessProfileId String? googleMapsUrl String? googleReviewUrl String? address String? phone String? email String? timezone String @default("UTC") status Status @default(ACTIVE) campaigns QrCampaign[] feedback CustomerFeedback[] googleLocations GoogleLocation[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? @@index([tenantId]) @@index([businessId]) }
model QrCampaign { id String @id @default(cuid()) tenantId String businessId String locationId String business Business @relation(fields:[businessId],references:[id]) location Location @relation(fields:[locationId],references:[id]) name String type String slug String @unique status Status @default(ACTIVE) startDate DateTime? endDate DateTime? createdById String style Json? codes QrCode[] scans QrScan[] reviewSessions ReviewSession[] feedback CustomerFeedback[] aiGenerations AiGeneration[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? @@index([tenantId]) @@index([businessId]) @@index([locationId]) @@index([createdAt]) }
model QrCode { id String @id @default(cuid()) campaignId String campaign QrCampaign @relation(fields:[campaignId],references:[id],onDelete:Cascade) format String size Int style Json? createdAt DateTime @default(now()) @@index([campaignId]) }
model QrScan { id String @id @default(cuid()) tenantId String campaignId String campaign QrCampaign @relation(fields:[campaignId],references:[id]) visitorHash String? device String? browser String? os String? referrer String? country String? city String? createdAt DateTime @default(now()) @@index([tenantId]) @@index([campaignId,createdAt]) }
model ReviewSession { id String @id @default(cuid()) tenantId String campaignId String campaign QrCampaign @relation(fields:[campaignId],references:[id]) visitorHash String? googleClickedAt DateTime? copiedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt feedback CustomerFeedback? aiGenerations AiGeneration[] @@index([tenantId]) @@index([campaignId,createdAt]) }
model CustomerFeedback { id String @id @default(cuid()) tenantId String locationId String campaignId String reviewSessionId String @unique location Location @relation(fields:[locationId],references:[id]) campaign QrCampaign @relation(fields:[campaignId],references:[id]) reviewSession ReviewSession @relation(fields:[reviewSessionId],references:[id]) score Int comment String? name String? email String? phone String? consent Boolean @default(false) status String @default("UNRESOLVED") notes String? tags FeedbackTagSelection[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([tenantId]) @@index([locationId,createdAt]) }
model FeedbackTag { id String @id @default(cuid()) tenantId String businessId String business Business @relation(fields:[businessId],references:[id]) label String active Boolean @default(true) selections FeedbackTagSelection[] @@unique([businessId,label]) @@index([tenantId]) }
model FeedbackTagSelection { feedbackId String tagId String feedback CustomerFeedback @relation(fields:[feedbackId],references:[id],onDelete:Cascade) tag FeedbackTag @relation(fields:[tagId],references:[id]) @@id([feedbackId,tagId]) }
model AiGeneration { id String @id @default(cuid()) tenantId String campaignId String? reviewSessionId String? campaign QrCampaign? @relation(fields:[campaignId],references:[id]) reviewSession ReviewSession? @relation(fields:[reviewSessionId],references:[id]) type String provider String model String inputTokens Int @default(0) outputTokens Int @default(0) createdAt DateTime @default(now()) @@index([tenantId,createdAt]) }
model AiUsage { id String @id @default(cuid()) tenantId String tenant Tenant @relation(fields:[tenantId],references:[id]) period String generations Int @default(0) tokens Int @default(0) @@unique([tenantId,period]) }
model GoogleConnection { id String @id @default(cuid()) tenantId String status String accessTokenEncrypted String? refreshTokenEncrypted String? expiresAt DateTime? locations GoogleLocation[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([tenantId]) }
model GoogleLocation { id String @id @default(cuid()) tenantId String connectionId String locationId String connection GoogleConnection @relation(fields:[connectionId],references:[id]) location Location @relation(fields:[locationId],references:[id]) externalId String reviews GoogleReview[] @@unique([connectionId,externalId]) @@index([tenantId]) }
model GoogleReview { id String @id @default(cuid()) tenantId String googleLocationId String googleLocation GoogleLocation @relation(fields:[googleLocationId],references:[id]) externalId String reviewerName String? rating Int comment String? reviewedAt DateTime replies GoogleReviewReply[] createdAt DateTime @default(now()) @@unique([googleLocationId,externalId]) @@index([tenantId,reviewedAt]) }
model GoogleReviewReply { id String @id @default(cuid()) tenantId String reviewId String review GoogleReview @relation(fields:[reviewId],references:[id]) text String approvedById String? sentAt DateTime? createdAt DateTime @default(now()) @@index([tenantId]) }
model Plan { id String @id @default(cuid()) name String slug String @unique active Boolean @default(true) monthlyPrice Int currency String @default("INR") features PlanFeature[] subscriptions Subscription[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model PlanFeature { id String @id @default(cuid()) planId String plan Plan @relation(fields:[planId],references:[id],onDelete:Cascade) key String value Json @@unique([planId,key]) }
model Subscription { id String @id @default(cuid()) tenantId String planId String tenant Tenant @relation(fields:[tenantId],references:[id]) plan Plan @relation(fields:[planId],references:[id]) provider String status SubscriptionStatus gatewaySubscriptionId String? currentPeriodEnd DateTime? payments Payment[] invoices Invoice[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([tenantId]) }
model Payment { id String @id @default(cuid()) tenantId String subscriptionId String? tenant Tenant @relation(fields:[tenantId],references:[id]) subscription Subscription? @relation(fields:[subscriptionId],references:[id]) gatewayPaymentId String? amount Int currency String status PaymentStatus createdAt DateTime @default(now()) @@index([tenantId,createdAt]) }
model Invoice { id String @id @default(cuid()) tenantId String subscriptionId String subscription Subscription @relation(fields:[subscriptionId],references:[id]) number String @unique amount Int currency String status String issuedAt DateTime @default(now()) @@index([tenantId]) }
model Coupon { id String @id @default(cuid()) code String @unique type String value Int active Boolean @default(true) expiresAt DateTime? createdAt DateTime @default(now()) }
model Agency { id String @id @default(cuid()) tenantId String @unique name String clients AgencyClient[] createdAt DateTime @default(now()) }
model AgencyClient { id String @id @default(cuid()) agencyId String tenantId String @unique agency Agency @relation(fields:[agencyId],references:[id]) tenant Tenant @relation(fields:[tenantId],references:[id]) createdAt DateTime @default(now()) }
model TeamInvitation { id String @id @default(cuid()) tenantId String email String role TenantRole tokenHash String @unique invitedById String invitedBy User @relation(fields:[invitedById],references:[id]) expiresAt DateTime acceptedAt DateTime? createdAt DateTime @default(now()) @@index([tenantId,email]) }
model Notification { id String @id @default(cuid()) tenantId String userId String? type String title String body String readAt DateTime? createdAt DateTime @default(now()) @@index([tenantId,createdAt]) }
model WebhookEndpoint { id String @id @default(cuid()) tenantId String tenant Tenant @relation(fields:[tenantId],references:[id]) url String secretHash String active Boolean @default(true) deliveries WebhookDelivery[] createdAt DateTime @default(now()) @@index([tenantId]) }
model WebhookDelivery { id String @id @default(cuid()) endpointId String endpoint WebhookEndpoint @relation(fields:[endpointId],references:[id]) event String payload Json status String attempts Int @default(0) nextAttemptAt DateTime? createdAt DateTime @default(now()) @@index([endpointId,createdAt]) }
model BillingWebhookEvent { id String @id @default(cuid()) provider String eventId String eventType String payload Json createdAt DateTime @default(now()) @@unique([provider,eventId]) @@index([provider,createdAt]) }
model ApiKey { id String @id @default(cuid()) tenantId String tenant Tenant @relation(fields:[tenantId],references:[id]) name String prefix String keyHash String @unique lastUsedAt DateTime? revokedAt DateTime? createdAt DateTime @default(now()) @@index([tenantId]) }
model AuditLog { id String @id @default(cuid()) tenantId String? tenant Tenant? @relation(fields:[tenantId],references:[id]) actorId String? action String entity String entityId String? metadata Json? createdAt DateTime @default(now()) @@index([tenantId,createdAt]) }
model SystemSetting { id String @id @default(cuid()) key String @unique valueEncrypted String? publicValue Json? updatedAt DateTime @updatedAt }
model TenantSetting { id String @id @default(cuid()) tenantId String @unique tenant Tenant @relation(fields:[tenantId],references:[id]) reviewFlow Json? ai Json? notifications Json? updatedAt DateTime @updatedAt }
model BrandSetting { id String @id @default(cuid()) tenantId String @unique tenant Tenant @relation(fields:[tenantId],references:[id]) platformName String? logoUrl String? faviconUrl String? primaryColor String? supportEmail String? supportPhone String? customDomain String? updatedAt DateTime @updatedAt }
model FileAsset { id String @id @default(cuid()) tenantId String key String @unique provider String mimeType String size Int createdAt DateTime @default(now()) @@index([tenantId]) }
